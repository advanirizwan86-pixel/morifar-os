# Required: generate at least 32 random bytes. Never commit the real value.
AUTH_SECRET=
# Required only on first start to create the initial Super Admin (minimum 12 characters).
MORIFAR_BOOTSTRAP_PASSWORD=
MORIFAR_BOOTSTRAP_EMAIL=admin@your-company.com
MORIFAR_BOOTSTRAP_NAME=System Administrator
# Optional persistent database location.
MORIFAR_DATABASE_PATH=./data/morifar.db

# This release supports dummy data only; live mode fails closed.
MORIFAR_DATA_MODE=dummy

# Required before MFA enrollment or photo uploads. Separate from AUTH_SECRET.
# Generate 32 random bytes represented by exactly 64 hexadecimal characters.
MORIFAR_ENCRYPTION_KEY=
# Private absolute path outside public/, on encrypted persistent UAE storage.
MORIFAR_FILE_ROOT=
# Absolute ClamAV scanner path; uploads fail closed if unavailable or unhealthy.
MORIFAR_CLAMSCAN_PATH=/usr/bin/clamscan
# Separate random secret for the internal notification job endpoint.
MORIFAR_JOB_TOKEN=
